# LLM — OpenRouter (default)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
DEFAULT_LLM_PROVIDER=openrouter
# Optional OpenRouter ranking headers
# OPENROUTER_SITE_URL=https://github.com/your/repo
# OPENROUTER_SITE_NAME=Autonomous ML Agent

# Optional direct providers (only if not using OpenRouter)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Configuration
MAX_COMPUTE_BUDGET=3600  # seconds
MAX_MODELS_TO_TRAIN=10
DEFAULT_TARGET_METRIC=accuracy

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ml_agent.log

# Data ingest — FRED + SEC EDGAR (Step 1 panel build)
FRED_API_KEY=your_fred_api_key_here
SEC_CONTACT_EMAIL=you@example.com
SEC_USER_AGENT=AutonomousMLAgent/0.1 (you@example.com)
